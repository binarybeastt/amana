diff --git a/src/commands/pczt/send_raw.rs b/src/commands/pczt/send_raw.rs
new file mode 100644
index 0000000..5b482c1
--- /dev/null
+++ b/src/commands/pczt/send_raw.rs
@@ -0,0 +1,67 @@
+use std::path::PathBuf;
+
+use anyhow::anyhow;
+use clap::Args;
+use rand::{rand_core::UnwrapErr, rngs::SysRng};
+use zcash_client_backend::{data_api::WalletRead, proto::service};
+use zcash_client_sqlite::{WalletDb, util::SystemClock};
+use zcash_protocol::TxId;
+
+use crate::{config::WalletConfig, data::get_db_paths, error, remote::ConnectionArgs};
+
+// Options accepted for the `pczt send-raw` command
+#[derive(Debug, Args)]
+pub(crate) struct Command {
+    #[command(flatten)]
+    connection: ConnectionArgs,
+
+    /// Path to a file of raw transaction bytes.
+    #[arg(long, conflicts_with = "txid")]
+    file: Option<PathBuf>,
+
+    /// Txid (display order) of a transaction stored in the wallet; its stored raw bytes are sent.
+    #[arg(long)]
+    txid: Option<String>,
+}
+
+impl Command {
+    pub(crate) async fn run(self, wallet_dir: Option<String>) -> Result<(), anyhow::Error> {
+        let config = WalletConfig::read(wallet_dir.as_ref())?;
+        let params = config.network();
+
+        let data = match (&self.file, &self.txid) {
+            (Some(path), None) => std::fs::read(path)?,
+            (None, Some(txid)) => {
+                let mut bytes = <[u8; 32]>::try_from(hex::decode(txid)?.as_slice())
+                    .map_err(|_| anyhow!("txid must be 32 bytes of hex"))?;
+                bytes.reverse();
+                let (_, db_data) = get_db_paths(wallet_dir.as_ref());
+                let db = WalletDb::for_path(db_data, params, SystemClock, UnwrapErr(SysRng))?;
+                let tx = db
+                    .get_transaction(TxId::from_bytes(bytes))?
+                    .ok_or_else(|| anyhow!("transaction {txid} not in wallet"))?;
+                let mut raw = vec![];
+                tx.write(&mut raw)?;
+                raw
+            }
+            _ => return Err(anyhow!("pass exactly one of --file or --txid")),
+        };
+
+        let mut client = self.connection.connect(params, wallet_dir.as_ref()).await?;
+        println!("Sending transaction...");
+        let response = client
+            .send_transaction(service::RawTransaction { data, height: 0 })
+            .await?
+            .into_inner();
+        if response.error_code != 0 {
+            Err(error::Error::SendFailed {
+                code: response.error_code,
+                reason: response.error_message,
+            }
+            .into())
+        } else {
+            println!("sent");
+            Ok(())
+        }
+    }
+}
