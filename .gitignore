# Rust
target/
# Android
*.iml
.gradle/
local.properties
build/
.idea/
# External clones (zcash-devtool etc.)
third_party/
# Wallet data and secrets: never commit
*.sqlite
*.db
wallets/
*.seed
.env
.DS_Store
# Crash-test evidence (wallet DB copies)
stress/p1/failures*/
# Wallet keys anywhere (encrypted mnemonics, age identities): never commit
keys.toml
*.age
# ...except the app's wrapper, so `./gradlew` works from a clean clone
!android/gradle/wrapper/gradle-wrapper.jar
!android/gradle/wrapper/gradle-wrapper.properties
# Built by the app's Gradle build from offline-core
android/app/src/main/jniLibs/
# Per-run pending-payment snapshots: raw tx hex, ~25 MB, all mined (kept locally only)
stress/p4/logs/**/pend*.json

# Built APKs handed out for install
dist/
demo/
